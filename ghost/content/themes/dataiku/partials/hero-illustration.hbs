{{!-- Brand illustration: geometric shapes + thin lines + the approved Blue Grey → Green → Beige
     gradient with a subtle grain overlay. Decorative only. --}}
<svg class="dk-illustration" viewBox="0 0 520 520" aria-hidden="true" focusable="false">
    <defs>
        <linearGradient id="dk-grad" x1="0" y1="1" x2="1" y2="0">
            <stop offset="0" stop-color="#42485B"/>
            <stop offset="0.55" stop-color="#3EDAB2"/>
            <stop offset="1" stop-color="#F8F4E4"/>
        </linearGradient>
        <radialGradient id="dk-grad-r" cx="0.7" cy="0.3" r="0.8">
            <stop offset="0" stop-color="#F8F4E4"/>
            <stop offset="0.45" stop-color="#3EDAB2"/>
            <stop offset="1" stop-color="#42485B"/>
        </radialGradient>
        <filter id="dk-grain" x="0" y="0" width="100%" height="100%">
            <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch" result="noise"/>
            <feColorMatrix in="noise" type="saturate" values="0" result="mono"/>
            <feComponentTransfer in="mono" result="alpha"><feFuncA type="table" tableValues="0 0.18"/></feComponentTransfer>
            <feComposite in="alpha" in2="SourceGraphic" operator="in" result="grain"/>
            <feMerge><feMergeNode in="SourceGraphic"/><feMergeNode in="grain"/></feMerge>
        </filter>
    </defs>
    <g fill="none" stroke="#FFFEF9" stroke-width="1" opacity="0.55">
        <ellipse cx="260" cy="260" rx="248" ry="96" transform="rotate(-24 260 260)"/>
        <ellipse cx="260" cy="260" rx="210" ry="210"/>
        <ellipse cx="260" cy="260" rx="160" ry="62" transform="rotate(32 260 260)"/>
    </g>
    <g filter="url(#dk-grain)">
        <circle cx="260" cy="260" r="150" fill="url(#dk-grad-r)"/>
        <path d="M110 412 A150 150 0 0 1 410 412 Z" fill="url(#dk-grad)" opacity="0.9"/>
        <circle cx="430" cy="118" r="34" fill="url(#dk-grad)"/>
    </g>
    <g fill="none" stroke="#FFFEF9" stroke-width="1">
        <circle cx="260" cy="260" r="186" stroke-dasharray="2 6" opacity="0.7"/>
        <path d="M60 300 C160 240 360 240 470 180" opacity="0.8"/>
    </g>
    <circle cx="470" cy="180" r="4" fill="#3EDAB2"/>
    <circle cx="60" cy="300" r="3" fill="#FFFEF9"/>
</svg>
