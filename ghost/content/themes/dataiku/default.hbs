<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    <title>{{meta_title}}</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {{!-- Brand fonts (Signifier, Untitled Sans, Söhne Mono) are licensed and are used when installed
         or self-hosted in assets/fonts. Inter is the approved web fallback for body copy, and
         Material Symbols Sharp is the approved corporate icon set. --}}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Material+Symbols+Sharp:opsz,wght,FILL,GRAD@24,500,1,200&display=swap">

    <link rel="stylesheet" type="text/css" href="{{asset "css/screen.css"}}">

    {{ghost_head}}
</head>
<body class="{{body_class}} footer-{{#match @custom.footer_surface "Core Black"}}black{{else}}green{{/match}} code-theme-{{#match @custom.code_theme "Brand"}}brand{{else match @custom.code_theme "Midnight"}}midnight{{else match @custom.code_theme "Light"}}light{{else}}vivid{{/match}}">

<div class="dk-viewport">

    {{> "header"}}

    {{{body}}}

    {{> "footer"}}

</div>

<script src="{{asset "js/main.js"}}" defer></script>

{{#is "post, page"}}
    {{!-- Syntax highlighting for code cards. The autoloader fetches each language grammar only
          when a code block on the page uses it. Token colours live in screen.css. --}}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-core.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/autoloader/prism-autoloader.min.js" defer></script>
{{/is}}

{{ghost_foot}}
</body>
</html>
